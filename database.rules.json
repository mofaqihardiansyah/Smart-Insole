{
  "rules": {
    ".read": false,
    ".write": false,

    "readings": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() !== false",
      ".write": false
    },

    "config": {
      "global": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['safeThreshold', 'dangerThreshold']) && newData.child('safeThreshold').isNumber() && newData.child('dangerThreshold').isNumber() && newData.child('safeThreshold').val() > 0 && newData.child('dangerThreshold').val() > newData.child('safeThreshold').val()"
      }
    },

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "devices": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$deviceId": {
        "readings": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() !== false && (root.child('users').child(auth.uid).child('devices').child($deviceId).val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },

    "audit": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "triage": {
      "$deviceId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}
