# ============================================================
# Konfigurasi Firebase Web SDK — Smart Insole Dashboard
# ============================================================
# CARA PAKAI:
#   1. Salin berkas ini menjadi : .env.local
#   2. Isi nilai sesuai Firebase Console > Project Settings
#   3. JANGAN commit .env.local (sudah di-ignore .gitignore)
#
#   Salin: cp .env.example .env.local
# ============================================================

# ---- Firebase Web SDK Config (Project Settings > General > Your apps) ----
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ---- Jalur node di Realtime Database ----
VITE_FB_PATH_LATEST=readings/latest
VITE_FB_PATH_HISTORY=readings/history

# ---- Ambang notifikasi (Early Warning System) ----
VITE_ALERT_SUSTAINED_SECONDS=30

# ============================================================
# Email OTP (EmailJS free tier) - halaman verifikasi & lupa sandi
# ============================================================
# Buat akun gratis di https://www.emailjs.com, lalu:
#   1. Tambahkan satu Email Service (Gmail atau penyedia lain).
#   2. Buat template dengan variabel:
#      {{to_email}}, {{to_name}}, {{otp_code}}, {{purpose}},
#      {{expires_in}}, {{app_name}}
#   3. Salin Service ID, Template ID, dan Public Key ke bawah ini.
#
# Tanpa nilai ini, build produksi menampilkan pesan bahwa pengiriman email
# belum dikonfigurasi. Build development menampilkan kode di halaman agar alur
# tetap bisa dicoba.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
