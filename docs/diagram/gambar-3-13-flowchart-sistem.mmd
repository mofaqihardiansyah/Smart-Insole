  G --> H["peak = maks 3 region<br/>perbarui durasi"]
  H --> I["Inferensi<br/>level dan skor"]
  I --> J{"Siap kirim?<br/>Wi-Fi dan waktu"}
  J -- ya --> K["Tulis latest<br/>dan history"]
  K --> L["delay 50 ms"]
  F -- belum --> L
  J -- belum --> L
  L --> D

  classDef step fill:#f8fafc,stroke:#475569,stroke-width:1px
  classDef net fill:#eff6ff,stroke:#1d4ed8,stroke-width:1px
