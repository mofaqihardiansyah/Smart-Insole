flowchart TD
  A([Mulai]) --> B["Inisialisasi ADC<br/>dan pin"]
  B --> C["Koneksi Wi-Fi<br/>dan sinkron NTP"]
  C --> D([Loop tiap 50 ms])
  D --> E["Segarkan buzzer"]
